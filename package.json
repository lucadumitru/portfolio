{
	"name": "lucadevelop-portfolio",
	"version": "1.2.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . --fix",
		"format": "prettier . --write",
		"lint-inspector": "npx @eslint/config-inspector",
		"prepare": "husky",
		"pre-commit": "lint-staged",
		"pre-push": "npm run lint && npm run format && npm run build",
		"clean": "rm -rf node_modules && rm package-lock.json",
		"generate:notion-sdk": "npx notion-ts-client@latest generate && prettier --write ./src/notion-sdk && eslint --fix ./src/notion-sdk"
	},
	"dependencies": {
		"@next/bundle-analyzer": "^15.1.5",
		"@plaiceholder/next": "^3.0.0",
		"@vercel/analytics": "^1.4.1",
		"@vercel/speed-insights": "^1.1.0",
		"@vercel/toolbar": "^0.1.30",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"framer-motion": "^11.18.1",
		"hamburger-react": "^2.5.0",
		"lucide-react": "^1.14.0",
		"next": "^16.2.4",
		"next-themes": "^0.4.3",
		"plaiceholder": "^3.0.0",
		"postcss": "^8.4.49",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-type-animation": "^3.1.0",
		"shadcn": "^4.7.0",
		"sharp": "^0.34.3",
		"short-uuid": "^6.0.3",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@babel/core": "^7.26.0",
		"@siberiacancode/eslint": "^2.7.0",
		"@tailwindcss/postcss": "^4.0.3",
		"@types/node": "^22.10.7",
		"@types/react": "^19.2.7",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-react-hooks": "^5.1.0",
		"husky": "^9.1.7",
		"prettier": "^3.0.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"schema-dts": "^2.0.0",
		"tailwindcss": "^4.0.3",
		"typescript": "^5.7.3"
	}
